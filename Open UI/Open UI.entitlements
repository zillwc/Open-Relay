<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Background GPU Access (com.apple.developer.background-tasks.continued-processing.gpu)
	     requires the paid Apple Developer Program under personal-team
	     provisioning, so it's removed here. Effect: on-device ASR
	     (Parakeet/MLX) transcription stops if the app is backgrounded
	     mid-transcription instead of continuing; foreground transcription
	     is unaffected. -->
	<!-- App Groups requires the paid Apple Developer Program and is not
	     available under free/personal-team provisioning. Removed so the
	     widget/share-extension targets' shared-storage features degrade
	     instead of failing to sign; the main chat app is unaffected. -->
</dict>
</plist>
